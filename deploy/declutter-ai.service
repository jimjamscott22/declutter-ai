[Unit]
Description=DeclutterAI room organization app
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=declutter-ai
Group=declutter-ai
WorkingDirectory=/opt/declutter-ai
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/declutter-ai.env
ExecStart=/usr/bin/node /opt/declutter-ai/node_modules/tsx/dist/cli.mjs /opt/declutter-ai/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
